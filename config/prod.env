# Production-like: a data folder on a mounted volume, no demo data, real secrets supplied by the environment.
# Set TMS_SENSOR_API_KEY, TMS_PREEMPTION_KEY and TMS_EVIDENCE_KEY as environment variables (not in this file).
TMS_DATABASE_URL=sqlite:////data/tms.db
TMS_SEED_DEMO=0
TMS_AUTOTICK=1
TMS_HOST=0.0.0.0
TMS_PORT=8443
TMS_BACKUP_DIR=/data/backups
TMS_BACKUP_KEEP=30
TMS_TLS_CERT=/data/certs/tms-cert.pem
TMS_TLS_KEY=/data/certs/tms-key.pem
